{
  "name": "saicmotor-cli",
  "version": "0.1.0",
  "description": "面向 AI Agent 的企业 CLI 工具平台：skill 编排 + catalog 声明 + 引擎执行",
  "type": "commonjs",
  "bin": { "saicmotor": "scripts/run.js" },
  "files": [
    "dist/",
    "skills/",
    "catalog/",
    "scripts/",
    "saicmotor.config.json"
  ],
  "scripts": {
    "prepare": "node -e \"if(!require('fs').existsSync('dist/cli/index.js'))console.warn('⚠ dist/ 缺失，请运行 npm run build')\"",
    "prepublishOnly": "npm run build && npm test",
    "postinstall": "node scripts/postinstall.js || true",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts"
  },
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a5535772/saicmotor-cli.git"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}